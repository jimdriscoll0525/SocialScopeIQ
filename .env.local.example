# Copy this file to .env.local and fill in real values.

# Supabase — Settings -> API in the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — SECRET. Used only by the cron scout, the bookmarklet
# endpoint, the blog cron, and scripts. Never commit. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anthropic API key for drafting/classification/blog generation.
# Get from console.anthropic.com
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Shared secret for the Vercel crons (/api/scout, /api/blog-cron).
# REQUIRED in production — those routes reject everything if it's unset.
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=PICK-ANY-LONG-RANDOM-STRING

# Apify — powers the Reddit and BiggerPockets scouts. From apify.com console.
# If unset, those scouts safely return no leads (they never error the run).
APIFY_API_TOKEN=YOUR-APIFY-TOKEN

# Optional: Stack Exchange API key (raises the request quota). Leave unset to skip.
STACKEXCHANGE_API_KEY=

# The owner's (Jim's) auth user id. The daily scout drafts LO responses in
# this profile's voice. Set after signing up + completing onboarding
# (Supabase dashboard -> Authentication -> Users, or: select id from profiles).
OWNER_USER_ID=

# Optional model overrides — defaults live in lib/config.ts.
# DRAFT_MODEL=claude-sonnet-4-6
# CLASSIFY_MODEL=claude-haiku-4-5
# BLOG_MODEL=claude-opus-5

# Resend — lead-alert emails from the public landing pages (/blog/2-1-buydown).
# Create an API key at resend.com/api-keys. If unset, the form still saves
# leads to Supabase and logs what it would have sent (safe for local dev).
RESEND_API_KEY=

# Where lead alerts go. Defaults to jim@meploans.com (the Resend account
# owner's address) if unset.
LEAD_ALERT_EMAIL=jim@meploans.com

# The From address for lead alerts. The default onboarding@resend.dev works
# without domain verification but ONLY delivers to the Resend account owner's
# email (jim@meploans.com). Optionally verify a domain in Resend
# (Domains -> Add Domain), then use e.g. "Jim Driscoll <leads@meploans.com>".
RESEND_FROM_EMAIL=

# Optional: canonical site origin used in magic-link emails and sitemaps.
# Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=
